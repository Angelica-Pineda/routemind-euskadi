{
	"name": "pl_historical_readings_by_month_station",
	"properties": {
		"activities": [
			{
				"name": "lookup_get_stations",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_adls_flatfiles",
						"type": "DatasetReference",
						"parameters": {
							"path": "weather/stations",
							"filename": "weather_stations.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lookup_get_stations",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lookup_get_stations').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_http_flatfiles_weather_history",
									"type": "DatasetReference",
									"parameters": {
										"year": {
											"value": "@pipeline().parameters.param_year",
											"type": "Expression"
										},
										"month": {
											"value": "@pipeline().parameters.param_month",
											"type": "Expression"
										},
										"sensor": {
											"value": "@item().codigo",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_flatfiles",
									"type": "DatasetReference",
									"parameters": {
										"path": {
											"value": "/weather/historical_readings/@{pipeline().parameters.param_year}/@{pipeline().parameters.param_month}",
											"type": "Expression"
										},
										"filename": {
											"value": "@{item().codigo}.xml",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"param_year": {
				"type": "string"
			},
			"param_month": {
				"type": "string"
			}
		},
		"annotations": []
	}
}