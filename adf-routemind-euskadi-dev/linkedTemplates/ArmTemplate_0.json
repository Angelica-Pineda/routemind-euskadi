		{
			"name": "[concat(parameters('factoryName'), '/ds_rest_cultural_events')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_REST_OpenDataEuskadi",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"year_month": {
						"type": "string"
					},
					"pagenum": {
						"type": "string"
					}
				},
				"folder": {
					"name": "Source"
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@concat('culture/events/v1.0/events/byMonth/',dataset().year_month,'?_elements=500&_page=',dataset().pagenum)",
