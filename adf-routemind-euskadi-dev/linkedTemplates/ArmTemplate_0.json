				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@concat('contenidos/ds_meteorologicos/met_stations_ds_', dataset().year, '/opendata/', dataset().year, '/', dataset().sensor, '/', dataset().sensor, '_', dataset().year, '_', dataset().month, '.xml')",
