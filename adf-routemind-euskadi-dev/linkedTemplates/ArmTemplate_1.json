{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-routemind-euskadi-dev"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingestion_one_time_load_restaurants')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "XmlSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "XmlReadSettings",
									"validationMode": "none",
									"namespaces": true
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_http_xml_flatfiles",
								"type": "DatasetReference",
								"parameters": {
									"url_data": "/contenidos/ds_recursos_turisticos/restaurantes_sidrerias_bodegas/opendata/restaurantes.xml"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_flatfiles",
								"type": "DatasetReference",
								"parameters": {
									"path": "restaurants",
									"filename": {
										"value": "@concat('restaurant_', formatDateTime(utcNow(), 'yyyy_MM_dd'), '.json')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingestion_one_time_load_weather_station')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_http_flatfiles",
								"type": "DatasetReference",
								"parameters": {
									"url_data": "/contenidos/ds_meteorologicos/estaciones_meteorologicas/opendata/estaciones.json"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_flatfiles",
								"type": "DatasetReference",
								"parameters": {
									"path": "weather/stations",
									"filename": {
										"value": "@concat('weather_stations_', formatDateTime(utcNow(), 'yyyy_MM_dd'), '.json')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingestion_daily_api_cultural_events')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach month",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('array_month')",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "Web_getMetadata",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"headers": {},
										"url": {
											"value": "@concat('https://api.euskadi.eus/culture/events/v1.0/events/byMonth/', formatDateTime(addToTime(utcNow(), int(item()), 'Month'), 'yyyy/M'), '?_elements=500&_page=1')",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Execute Paging Pipeline",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Web_getMetadata",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_api_paging",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"year_month": {
												"value": "@formatDateTime(addToTime(utcNow(), int(item()), 'Month'), 'yyyy/M')",
												"type": "Expression"
											},
											"total_pages": {
												"value": "@int(activity('Web_getMetadata').output.totalPages)",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"array_month": {
						"type": "Array",
						"defaultValue": [
							0,
							1,
							2
						]
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingestion_one_time_load_air_quiality_historical_readings')]",
